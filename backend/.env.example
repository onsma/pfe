APP_NAME=BFPME Risk Backend
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000

MODEL_ARTIFACT_PATH=c:/pfe/data/option_c_randomforest_model.joblib
MODEL_METRICS_PATH=c:/pfe/data/option_c_randomforest_metrics.json

# Decision cutoff on probability_default. PD >= this => predicted default (risky).
# Lower it (e.g. 0.3) to catch more risky clients; raise it to reduce false alarms.
DEFAULT_THRESHOLD=0.6

LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
# Max length of the LLM answer (concise but informative). Lower => shorter.
LLM_MAX_TOKENS=500
